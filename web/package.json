{
  "name": "digital-brain-web",
  "version": "0.6.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "migrate": "wrangler d1 migrations apply DB --local",
    "import:x": "tsx scripts/import-x.ts",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "dedupe": "tsx scripts/dedupe.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "better-auth": "^1.7.6",
    "fflate": "^0.8.3",
    "next": "15.5.26",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.142.0"
  }
}
