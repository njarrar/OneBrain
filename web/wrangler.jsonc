{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "digital-brain",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "digital-brain" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "digital-brain",
      // Make your own with `npx wrangler d1 create digital-brain` and paste its id here.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "digital-brain-files" }],
  // Search by meaning, Related and Ask Brain. The app still works if these are missing.
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "VECTORS", "index_name": "digital-brain-items" }],
  "vars": { "BETTER_AUTH_URL": "https://brain.example.workers.dev" },
  "triggers": { "crons": ["0 */6 * * *"] },
  "observability": { "enabled": true }
}
